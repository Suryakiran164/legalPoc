# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# JWT used for our own session tokens
JWT_SECRET=some_random_string_for_jwt_by_sk

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=scan-images

# OCR microservice (fallback)
OCR_SERVICE_URL=http://localhost:8001

# Gemini (primary OCR / vision) - server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2
GEMINI_CONFIDENCE_THRESHOLD=0.6

# Optional dual-OCR verification (when true, both Gemini and EasyOCR run and are compared)
ENABLE_DUAL_OCR=false
